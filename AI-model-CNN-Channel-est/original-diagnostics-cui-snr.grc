- name: epy_block_iq_tag_sink
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass\
      \ blk(gr.sync_block):\n    def __init__(self, frequency_callback=lambda value:\
      \ None):\n        gr.sync_block.__init__(self, name='IQ Tag Frequency Retuner',\n\
      \                               in_sig=[np.complex64], out_sig=None)\n     \
      \   self.frequency_callback = frequency_callback\n        self.frequency_key\
      \ = pmt.intern('rx_freq')\n\n    def work(self, input_items, output_items):\n\
      \        count = len(input_items[0])\n        for tag in self.get_tags_in_window(0,\
      \ 0, count, self.frequency_key):\n            self.frequency_callback(pmt.to_double(tag.value))\n\
      \        return count\n"
    affinity: ''
    alias: ''
    comment: ''
    frequency_callback: 'lambda value: self.set_freq(value)'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('IQ Tag Frequency Retuner', 'blk', [('frequency_callback', '<function
      blk.<lambda> at 0x7fc5153f9bc0>')], [('0', 'complex', 1)], [], '', ['frequency_callback'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [816, 244.0]
    rotation: 0
    state: enabled
- name: epy_snr_csv
  id: epy_block
  parameters:
    _source_code: "import csv\nimport threading\nfrom pathlib import Path\n\nimport\
      \ numpy as np\nimport pmt\nfrom gnuradio import gr\n\n\nclass snr_csv(gr.basic_block):\n\
      \    \"\"\"One unbinned row per CRC-valid diagnostic PDU; no cross-frame joins.\"\
      \"\"\n\n    def __init__(self, output_path='data/tmp_out/snr_ber_evm_cpu.csv',\n\
      \                 estimator_label='LS'):\n        gr.basic_block.__init__(self,\
      \ name='SNR BER EVM CSV', in_sig=None, out_sig=None)\n        self.output_path\
      \ = output_path\n        self.estimator_label = str(estimator_label)\n     \
      \   self.output_file = None\n        self.writer = None\n        self.frame_index\
      \ = 0\n        self.lock = threading.Lock()\n        self.message_port_register_in(pmt.intern('diag'))\n\
      \        self.set_msg_handler(pmt.intern('diag'), self._handle_diag)\n\n   \
      \ def start(self):\n        output = Path(self.output_path)\n        output.parent.mkdir(parents=True,\
      \ exist_ok=True)\n        self.output_file = output.open('w', newline='', encoding='utf-8')\n\
      \        self.writer = csv.writer(self.output_file)\n        self.frame_index\
      \ = 0\n        self.writer.writerow([\n            'frame_index', 'estimator',\
      \ 'frame_bytes', 'encoding', 'snr_db',\n            'bit_errors', 'bits_compared',\
      \ 'ber', 'evm_rms_percent', 'evm_rms_db',\n            'evm_error_power', 'evm_reference_power',\n\
      \        ])\n        self.output_file.flush()\n        return True\n\n    @staticmethod\n\
      \    def _metadata(metadata, key):\n        value = pmt.dict_ref(metadata, pmt.intern(key),\
      \ pmt.PMT_NIL)\n        if pmt.is_uint64(value):\n            return int(pmt.to_uint64(value))\n\
      \        if pmt.is_real(value):\n            return float(pmt.to_double(value))\n\
      \        return ''\n\n    def _handle_diag(self, message):\n        if not pmt.is_pair(message):\n\
      \            return\n        metadata, diagnostic = pmt.car(message), pmt.cdr(message)\n\
      \        if not pmt.is_dict(metadata) or not pmt.is_dict(diagnostic):\n    \
      \        return\n        bits = []\n        for key in ('pre_viterbi', 'corrected_coded'):\n\
      \            value = pmt.dict_ref(diagnostic, pmt.intern(key), pmt.PMT_NIL)\n\
      \            if not pmt.is_u8vector(value):\n                return\n      \
      \      bits.append(np.asarray(pmt.u8vector_elements(value), dtype=np.uint8))\n\
      \        received, reference = bits\n        if (not received.size or received.size\
      \ != reference.size or\n                np.any(received > 1) or np.any(reference\
      \ > 1)):\n            return\n        errors = int(np.count_nonzero(received\
      \ != reference))\n        evm_percent = evm_db = error_power = reference_power\
      \ = ''\n        tx = pmt.dict_ref(diagnostic, pmt.intern('transmitted_iq'),\
      \ pmt.PMT_NIL)\n        eq = pmt.dict_ref(diagnostic, pmt.intern('equalized_iq'),\
      \ pmt.PMT_NIL)\n        if pmt.is_c32vector(tx) and pmt.is_c32vector(eq):\n\
      \            tx = np.asarray(pmt.c32vector_elements(tx), dtype=np.complex128)\n\
      \            eq = np.asarray(pmt.c32vector_elements(eq), dtype=np.complex128)\n\
      \            if (tx.size and tx.size % 48 == 0 and tx.size == eq.size and\n\
      \                    np.all(np.isfinite(tx)) and np.all(np.isfinite(eq))):\n\
      \                power = float(np.vdot(tx, tx).real)\n                if power\
      \ > 0:\n                    reference_power = power\n                    error_power\
      \ = float(np.vdot(eq - tx, eq - tx).real)\n                    ratio = float(np.sqrt(error_power\
      \ / reference_power))\n                    evm_percent = 100.0 * ratio\n   \
      \                 evm_db = float(20 * np.log10(ratio)) if ratio else float('-inf')\n\
      \        with self.lock:\n            if self.output_file is None:\n       \
      \         return\n            self.frame_index += 1\n            self.writer.writerow([\n\
      \                self.frame_index, self.estimator_label,\n                self._metadata(metadata,\
      \ 'frame bytes'), self._metadata(metadata, 'encoding'),\n                self._metadata(metadata,\
      \ 'snr'), errors, int(received.size),\n                errors / received.size,\
      \ evm_percent, evm_db, error_power, reference_power,\n            ])\n     \
      \       self.output_file.flush()\n\n    def stop(self):\n        with self.lock:\n\
      \            if self.output_file is not None:\n                self.output_file.close()\n\
      \                self.output_file = None\n        return True\n"
    affinity: ''
    alias: ''
    comment: ''
    estimator_label: '"_"'
    maxoutbuf: '0'
    minoutbuf: '0'
    output_path: diagnostic_output
  states:
    _io_cache: ('SNR BER EVM CSV', 'snr_csv', [('output_path', "'data/tmp_out/snr_ber_evm_cpu.csv'"),
      ('estimator_label', "'LS'")], [('diag', 'message', 1)], [], 'One unbinned row
      per CRC-valid diagnostic PDU; no cross-frame joins.', ['estimator_label', 'output_path'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1352, 772.0]
    rotation: 0
    state: enabled
