connections:
- [blocks_file_source_0, '0', blocks_interleaved_short_to_complex_0, '0']
- [blocks_interleaved_short_to_complex_0, '0', mlir_aie_sigmf_tag_injector_0, '0']
- [mlir_aie_cint32_to_complex64_0, '0', blocks_file_meta_sink_1, '0']
- [mlir_aie_complex64_to_cint16_0, '0', mlir_aie_mlir_aie_cpp_tagged_int32_to_int64_0,
  '0']
- [mlir_aie_mlir_aie_cpp_tagged_int32_to_int64_0, '0', mlir_aie_cint32_to_complex64_0,
