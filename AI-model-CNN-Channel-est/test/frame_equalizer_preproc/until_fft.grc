- name: mlir_aie_sigmf_tag_injector_0
  id: mlir_aie_sigmf_tag_injector
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    metadata_file: input_path+"-meta"
    minoutbuf: '0'
    start_sample: '0'
    tag_key: rx_freq
