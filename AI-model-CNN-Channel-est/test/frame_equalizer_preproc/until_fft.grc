options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: fft_dump
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: ''
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 12.0]
    rotation: 0
    state: enabled

blocks:
- name: data_dir
  id: variable
  parameters:
    comment: Dataset paths are relative to the generated script in base/test/frame_equalizer_preproc.
    value: str(__import__("pathlib").Path(globals().get("__file__", "base/test/frame_equalizer_preproc/fft_dump.py")).resolve().parents[3]
      / "AI-model-CNN-Channel-est" / "data")
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [960, 16.0]
    rotation: 0
    state: enabled
- name: dump_file
  id: variable
  parameters:
    comment: Scalarized complex64 FFT output with detached stream-tag metadata.
    value: dump_path or str(__import__("pathlib").Path(globals().get("__file__", "base/test/frame_equalizer_preproc/fft_dump.py")).resolve().parent
      / "tmp_data" / "fft.iqdata")
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1160, 276.0]
    rotation: 0
    state: enabled
- name: file_path
  id: variable
  parameters:
    comment: ''
    value: data_dir + "/raw_capture/stress_test.sigmf"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 116.0]
    rotation: 0
    state: disabled
- name: file_path
  id: variable
  parameters:
    comment: ''
    value: data_dir + "/raw_capture/room_20260927.sigmf"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [792, 92.0]
    rotation: 0
    state: disabled
- name: file_path
  id: variable
  parameters:
    comment: ''
    value: data_dir + "/raw_capture/stress_test_awgn_15db.sigmf"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [952, 140.0]
    rotation: 0
    state: enabled
- name: file_path
  id: variable
  parameters:
    comment: ''
    value: data_dir + "/raw_capture/206.sigmf"
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 140.0]
    rotation: 0
    state: disabled
- name: input_path
  id: variable
  parameters:
    comment: Use the command-line dataset when supplied, otherwise the enabled file_path.
    value: dataset or file_path
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1184, 188.0]
    rotation: 0
    state: enabled
- name: kernel_dir
  id: variable
  parameters:
    comment: Pipeline kernel built by kernel/Makefile.
    value: str(__import__("pathlib").Path(globals().get("__file__", "base/test/frame_equalizer_preproc/fft_dump.py")).resolve().parent.parent
      / "until_fft" / "kernel" / "build")
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [912, 252.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 20e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12.0]
    rotation: 0
    state: enabled
- name: sync_length
  id: variable
  parameters:
    comment: ''
    value: '320'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 156.0]
    rotation: 0
    state: enabled
- name: window_size
  id: variable
  parameters:
    comment: ''
    value: '48'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 92.0]
    rotation: 0
    state: enabled
- name: blocks_file_meta_sink_1
  id: blocks_file_meta_sink
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    detached: 'True'
    extra_dict: pmt.make_dict()
    file: dump_file
    max_seg_size: '1000000'
    rel_rate: '1'
    samp_rate: samp_rate
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 364.0]
    rotation: 0
    state: enabled
- name: blocks_file_source_0
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: input_path+"-data"
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    repeat: 'False'
    type: short
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [152, 164.0]
    rotation: 0
    state: enabled
- name: blocks_interleaved_short_to_complex_0
  id: blocks_interleaved_short_to_complex
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    scale_factor: '32768'
    swap: 'False'
    vector_input: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 188.0]
    rotation: 0
    state: enabled
- name: dataset
  id: parameter
  parameters:
    alias: ''
    comment: Optional SigMF prefix override, without the -data or -meta suffix.
    hide: none
    label: Dataset
    short_id: ''
    type: str
    value: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1416, 12.0]
    rotation: 0
    state: enabled
- name: dump_path
  id: parameter
  parameters:
    alias: ''
    comment: Destination for scalarized complex64 FFT output and detached .hdr tags.
    hide: none
    label: Dump path
    short_id: ''
    type: str
    value: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 20.0]
    rotation: 0
    state: enabled
- name: mlir_aie_cint32_to_complex64_0
  id: mlir_aie_cint32_to_complex64
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    fractional_bits: '15'
    integer_bits: '16'
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
